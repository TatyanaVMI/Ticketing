@using Ticketing.Models

@if (Visible && Receipt is not null)
{
    <div class="dialog-overlay" @onclick="Close">
        <div class="dialog" role="dialog" aria-modal="true" aria-labelledby="dialog-title" @onclick:stopPropagation="true">
            <p class="dialog__eyebrow">Purchase complete</p>
            <h2 id="dialog-title" class="dialog__title">Thank you</h2>
            <p class="dialog__text">@ConfirmationText</p>

            <ul class="dialog__list">
                @foreach (var seat in Receipt.Seats)
                {
                    <li>
                        <span>@seat.Label</span>
                        <span>@seat.PricePaid.ToString("C0")</span>
                    </li>
                }
            </ul>

            <div class="dialog__total">
                <span>Total paid</span>
                <span>@Receipt.Total.ToString("C0")</span>
            </div>

            <button type="button" class="dialog__button" @onclick="Close">Done</button>
        </div>
    </div>
}

@code {
    [Parameter]
    public bool Visible { get; set; }

    [Parameter]
    public PurchaseReceipt? Receipt { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    /// <summary>
    /// Only the door sentence is dropped from the original wording (FR-018); the purchased count stays,
    /// read from the recorded purchase, so the confirmation changes in the two ways FR-016 allows.
    /// </summary>
    private string ConfirmationText
    {
        get
        {
            if (Receipt is not { } receipt)
            {
                return "Your tickets are confirmed.";
            }

            var ticketWord = receipt.Seats.Count == 1 ? "ticket is" : "tickets are";
            return $"Your {ticketWord} confirmed. {receipt.Seats.Count} total.";
        }
    }

    private Task Close() => OnClose.InvokeAsync();
}