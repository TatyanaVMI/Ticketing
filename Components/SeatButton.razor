@using Ticketing.Models

<button type="button"
        class="seat @StateClass"
        disabled="@(Busy || !Seat.IsSelectable)"
        aria-pressed="@(Seat.State == SeatState.Selected)"
        aria-label="@AriaLabel"
        title="@Title"
        @onclick="OnClick">
    @Seat.Number
</button>

@code {
    [Parameter, EditorRequired]
    public Seat Seat { get; set; } = default!;

    /// <summary>True while a purchase is running, so the seat map cannot change underneath it.</summary>
    [Parameter]
    public bool Busy { get; set; }

    [Parameter]
    public EventCallback<Seat> OnToggle { get; set; }

    private string StateClass => Seat.State switch
    {
        SeatState.Selected => "seat--selected",
        SeatState.Occupied => "seat--occupied",
        _ => "seat--available"
    };

    private string AriaLabel => Seat.State == SeatState.Occupied
        ? $"{Seat.Label}, occupied"
        : $"{Seat.Label}, {Seat.Price:C0}";

    private string Title => Seat.State == SeatState.Occupied
        ? "Occupied"
        : $"{Seat.Label} — {Seat.Price:C0}";

    private Task OnClick() => OnToggle.InvokeAsync(Seat);
}